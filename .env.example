# Database
DATABASE_URL=postgresql://unstpbl:unstpbl_dev@localhost:5432/unstpbl

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourchurch.com

# App Config
CHURCH_TIMEZONE=Africa/Harare
CORS_ORIGINS=http://localhost:5173
CRON_SECRET=change-me-for-scheduled-jobs

# External APIs
BIBLE_API_KEY=

# Monitoring
SENTRY_DSN_API=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Text messages (SMS). Leave SMS_PROVIDER unset to stay in safe "test mode": messages are
# logged but nothing is sent or charged. See docs/SMS.md before going live.
SMS_PROVIDER=dryrun
SMS_MONTHLY_SEGMENT_CAP=300
SMS_COST_PER_SEGMENT_USD=
CHURCH_NAME=Victory Tabernacle City Mutare
# Public https address of this API (used for delivery receipts and STOP replies)
PUBLIC_API_URL=
# Only when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
